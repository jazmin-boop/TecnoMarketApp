<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER CURVO MORADO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="#7C3AED" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="48dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardCornerRadius="23dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_modulo_ventas"
                            app:tint="#7C3AED"
                            android:contentDescription="Icono Ventas" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gestión de Ventas"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Registro, comprobantes y transacciones"
                            android:textColor="#DDD6FE"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- CONTENIDO FLOTANTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="-40dp"
            android:paddingBottom="32dp">

            <!-- TARJETA CRUD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Datos de la Venta"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp" />

                    <!-- ID VENTA -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxBackgroundColor="#F8FAFC"
                        app:boxStrokeColor="#7C3AED"
                        app:hintTextColor="#7C3AED"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIdVenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="ID Venta (solo para actualizar/eliminar)"
                            android:inputType="number"
                            android:textSize="13sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- REUTILIZANDO SPINNER CON ITEMSPINNER (CLIENTES) -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cliente"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#64748B"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F8FAFC"
                        app:strokeColor="#E2E8F0"
                        app:strokeWidth="1dp"
                        android:layout_marginBottom="12dp">

                        <Spinner
                            android:id="@+id/spCliente"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="8dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SUBTOTAL, IGV Y TOTAL -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="18dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxBackgroundColor="#F8FAFC"
                            app:boxStrokeColor="#7C3AED"
                            app:hintTextColor="#7C3AED">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etSubtotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Subtotal (S/.)"
                                android:inputType="numberDecimal"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="4dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxBackgroundColor="#F8FAFC"
                            app:boxStrokeColor="#7C3AED"
                            app:hintTextColor="#7C3AED">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etIgv"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="IGV (18%)"
                                android:inputType="numberDecimal"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:layout_marginStart="4dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxBackgroundColor="#F5F3FF"
                            app:boxStrokeColor="#7C3AED"
                            app:hintTextColor="#7C3AED">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etTotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Total (S/.)"
                                android:inputType="numberDecimal"
                                android:textColor="#7C3AED"
                                android:textStyle="bold"
                                android:textSize="12sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- BOTONERA CRUD (IGUAL A PRODUCTOS) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegistrar"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:text="REGISTRAR"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:backgroundTint="#7C3AED"
                            app:elevation="2dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnActualizar"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:text="ACTUALIZAR"
                            android:textColor="#7C3AED"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:backgroundTint="#F3E8FF"
                            app:elevation="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnListar"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            android:text="LISTAR"
                            android:textColor="#475569"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:backgroundTint="#F1F5F9"
                            app:elevation="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEliminar"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            android:text="ELIMINAR"
                            android:textColor="#EF4444"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:backgroundTint="#FEE2E2"
                            app:elevation="0dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA CON BUSCADOR Y RECYCLERVIEW (ESPEJO DE PRODUCTOS) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Historial de Ventas"
                        android:textColor="#1E293B"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <!-- BÚSQUEDA INTEGRADA -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="14dp">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            app:boxCornerRadiusTopStart="14dp"
                            app:boxCornerRadiusTopEnd="14dp"
                            app:boxCornerRadiusBottomStart="14dp"
                            app:boxCornerRadiusBottomEnd="14dp"
                            app:boxBackgroundColor="#F8FAFC"
                            app:boxStrokeColor="#7C3AED"
                            app:hintTextColor="#7C3AED"
                            app:startIconDrawable="@android:drawable/ic_menu_search"
                            app:startIconTint="#64748B">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBuscar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Buscar por cliente o ID..."
                                android:textSize="13sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnBuscar"
                            android:layout_width="wrap_content"
                            android:layout_height="52dp"
                            android:text="BUSCAR"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="14dp"
                            app:backgroundTint="#7C3AED"
                            app:elevation="2dp" />
                    </LinearLayout>

                    <!-- RECYCLERVIEW DE VENTAS -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvVentas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>