<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER CURVO MORADO -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="#7C3AED" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="48dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardCornerRadius="23dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFFFFF"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_modulo_productos"
                            app:tint="#7C3AED"
                            android:contentDescription="Icono Producto" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Detalle del Producto"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ficha técnica e inventario"
                            android:textColor="#DDD6FE"
                            android:textSize="12sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- CONTENEDOR PRINCIPAL FLOTANTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:layout_marginTop="-40dp"
            android:paddingBottom="32dp">

            <!-- TARJETA SHOWCASE DE LA IMAGEN DEL MUEBLE -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="20dp">

                    <!-- CONTENEDOR DE IMAGEN -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F5F3FF"
                        app:strokeWidth="1dp"
                        app:strokeColor="#EDE9FE"
                        android:layout_marginBottom="18dp">

                        <ImageView
                            android:id="@+id/ivDetalleImagen"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:padding="16dp"
                            android:src="@drawable/mueble"
                            android:contentDescription="Imagen del mueble" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDetalleNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Escritorio Ejecutivo Moderno"
                        android:textColor="#1E293B"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <!-- CÓDIGO CHIP -->
                    <TextView
                        android:id="@+id/tvDetalleCodigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cód: MUB-001"
                        android:textColor="#64748B"
                        android:textSize="12sp"
                        android:background="#F1F5F9"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginTop="6dp" />

                    <!-- PRECIO FINTECH -->
                    <TextView
                        android:id="@+id/tvDetallePrecio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="S/ 489.00"
                        android:textColor="#7C3AED"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- TARJETA: INFORMACIÓN DE INVENTARIO -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información de Inventario"
                        android:textColor="#1E293B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Categoría -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#F8FAFC"
                            android:padding="12dp"
                            android:layout_marginEnd="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Categoría"
                                android:textColor="#94A3B8"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetalleCategoria"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Muebles de Oficina"
                                android:textColor="#334155"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <!-- Stock -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="#ECFDF5"
                            android:padding="12dp"
                            android:layout_marginStart="6dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Disponibilidad"
                                android:textColor="#059669"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvDetalleStock"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stock: 15 unid."
                                android:textColor="#047857"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Descripción -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descripción"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvDetalleDescripcion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Mueble fabricado en melamina de 18mm con acabado antirrayaduras, estructura metálica reforzada y pasacables integrado para oficina o estudio."
                        android:textColor="#475569"
                        android:textSize="13sp"
                        android:lineSpacingExtra="4dp"
                        android:background="#F8FAFC"
                        android:padding="14dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- BOTÓN VOLVER -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolver"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="VOLVER AL CATÁLOGO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:backgroundTint="#7C3AED"
                app:elevation="2dp" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>